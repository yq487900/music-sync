# 复制为 .env 后按需修改（不填则用下面的默认值）
# Web 界面端口
APP_PORT=13570

# ---- 宿主机上的三个音乐目录（必改：换成你自己的绝对路径）----
# 待整理：歌单下载 / 云盘下载 / 第三方搜集来的 / 本地原有的歌
MUSIC_DOWNLOAD_DIR=/path/to/your/music/download
# 整理后曲库（补齐标签/封面/歌词后的成品）
MUSIC_LIBRARY_DIR=/path/to/your/music/musics
# 回收站（整理页删掉的歌，可找回）
MUSIC_TRASH_DIR=/path/to/your/music/_trash
