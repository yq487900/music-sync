# MusicSync 环境变量配置示例
# 复制为 .env 并按需修改

# ---------- 基础 ----------
TZ=Asia/Shanghai
APP_PORT=8000
DEV_PORT=8001
HTTP_PORT=80
HTTPS_PORT=443

# ---------- 宿主机音乐目录 (必改) ----------
MUSIC_DIR=/mnt/music

# ---------- 配置文件目录 (可选，只读挂载) ----------
# CONFIG_DIR=./config

# ---------- 生产域名 (生产模式必填) ----------
# DOMAIN=music.yourdomain.com
# SSL_EMAIL=admin@yourdomain.com

# ---------- 资源限制 ----------
# MEMORY_LIMIT=512M
# CPU_LIMIT=1.0